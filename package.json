{
  "name": "phrasebook",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hostable, stack-agnostic Translation Management System",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "dotenv -- pnpm -r --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.6.3"
  }
}
