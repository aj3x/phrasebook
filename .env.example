DATABASE_URL=postgres://phrasebook:phrasebook@127.0.0.1:5432/phrasebook
PORT=3000
BIND_ADDR=127.0.0.1
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (CORS). Defaults
# to the editor/demo-web dev ports if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Auth (M2). Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-32-chars-min
BETTER_AUTH_URL=http://localhost:3000
